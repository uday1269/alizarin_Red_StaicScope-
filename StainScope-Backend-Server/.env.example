SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Bucket names (Private / Authenticated)
SUPABASE_MICROGRAPHS_BUCKET=micrographs
SUPABASE_OVERLAYS_BUCKET=analysis-overlays
